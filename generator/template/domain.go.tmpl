package {{.Name}}

import (
	"context"
	"errors"
)

// {{.Type}} is the {{.Name}} entity. Replace the example fields with your own.
type {{.Type}} struct {
	ID   int64
	Name string
}

// Domain errors. Wrap them with fmt.Errorf("%w: ...") to add detail; callers match them
// with errors.Is, and the transport layer maps them to status codes.
var (
	ErrNotFound = errors.New("{{.Name}}: not found")
	ErrInvalid  = errors.New("{{.Name}}: invalid input")
)

// Service is the {{.Name}} use-case contract, implemented by the service package.
type Service interface {
	// Get returns the {{.Name}} with the given ID, or ErrNotFound.
	Get(ctx context.Context, id int64) ({{.Type}}, error)
	// Create validates and stores a new {{.Name}}, returning it with its ID set.
	Create(ctx context.Context, in {{.Type}}) ({{.Type}}, error)
}
