package http

import (
	"context"
	"encoding/json"
	"io"
	"log"
	"net/http"
	"strconv"

	"{{.ImportPath}}"
)

// FooHandler is an example {{.Name}} HTTP handler.
type FooHandler struct {
	service {{.Name}}.Service
	scopes  map[Scope]ScopeSettings
}

// FooHandlerRequest is the FooHandler request body.
type FooHandlerRequest struct {
	Arg []Bar `json:"arg"`
}

// Bar is an example request item.
type Bar struct {
	Arg1 int64 `json:"arg1"`
	Arg2 int64 `json:"arg2"`
}

// FooHandlerResponse is the FooHandler response body.
type FooHandlerResponse struct {
	StandardEnvelope
	Data responseData `json:"data,omitempty"`
}

type responseData struct {
	Arg []{{.Name}}.Data `json:"arg,omitempty"`
}

func (h *FooHandler) ServeHTTP(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodPost {
		writeStandardError(w, http.StatusMethodNotAllowed, errMethodNotAllowed)
		return
	}

	ctx, cancel := context.WithTimeout(r.Context(), h.scopes[ScopeFooHandler].Timeout)
	defer cancel()

	// Buffered so the worker never blocks (and leaks) if the request times out first.
	resultCh := make(chan []{{.Name}}.Data, 1)
	errCh := make(chan *StandardError, 1)

	go func() {
		body, err := io.ReadAll(r.Body)
		if err != nil {
			log.Printf("[{{.Name}}] failed to read body: %+v", err)
			errCh <- newStandardError(http.StatusBadRequest, err)
			return
		}

		var req FooHandlerRequest
		if err := json.Unmarshal(body, &req); err != nil {
			log.Printf("[{{.Name}}] failed to unmarshal body: %+v", err)
			errCh <- newStandardError(http.StatusBadRequest, err)
			return
		}

		// add logic here, e.g. h.service.Get(ctx, id)

		resultCh <- []{{.Name}}.Data{}
	}()

	select {
	case <-ctx.Done():
		if ctx.Err() == context.Canceled {
			writeStandardError(w, http.StatusBadRequest, errBadRequest)
		} else {
			writeStandardError(w, http.StatusGatewayTimeout, errRequestTimeOut)
		}
	case httpErr := <-errCh:
		code, _ := strconv.Atoi(httpErr.Code)
		WriteErrorResponse(w, code, []StandardError{*httpErr})
	case result := <-resultCh:
		var res FooHandlerResponse
		res.Data.Arg = result
		res.Header = &StandardHeader{}
		res.Status = &StandardStatus{Message: http.StatusText(http.StatusOK)}

		data, err := json.Marshal(res)
		if err != nil {
			log.Printf("[{{.Name}}] failed to marshal result: %+v", err)
			writeStandardError(w, http.StatusInternalServerError, errInternalServerError)
			return
		}
		_, _ = WriteResponse(w, data, http.StatusOK, NewContentTypeDecorator("application/json"))
	}
}
