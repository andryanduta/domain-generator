// Package http exposes the {{.Name}} service over HTTP.
package http

import (
	"errors"
	"log"
	"net/http"
	"time"

	"{{.ImportPath}}"
)

// DefaultRequestTimeout is used for context cancellation of a request.
var DefaultRequestTimeout = 5000 * time.Millisecond

// Handler registers the {{.Name}} HTTP handlers.
type Handler struct {
	service      {{.Name}}.Service
	httpHandlers map[string]*httpHandler
}

type httpHandler struct {
	handler http.Handler
	url     string
}

// Option configures a Handler.
type Option func(*Handler)

// HTTPHandlerIdentity identifies a handler and the URL it serves.
type HTTPHandlerIdentity struct {
	ConfigName string
	URL        string
}

// Scope denotes a group of shared handler settings.
type Scope int

// The known Scopes.
const (
	_ Scope = iota
	ScopeFooHandler
)

// String returns the string representation of a Scope.
func (sc Scope) String() string { return ScopeName[sc] }

// ScopeName maps Scopes to names; ScopeValue is the reverse mapping.
// Register a new Scope by adding it to both.
var (
	ScopeName = map[Scope]string{
		ScopeFooHandler: "FooHandler",
	}

	ScopeValue = map[string]Scope{
		ScopeName[ScopeFooHandler]: ScopeFooHandler,
	}
)

// ScopeSettings are the configurable settings of a Scope.
type ScopeSettings struct {
	Timeout time.Duration
}

func getDefaultScopeSettings() map[Scope]ScopeSettings {
	defaults := make(map[Scope]ScopeSettings, len(ScopeValue))
	for _, scope := range ScopeValue {
		defaults[scope] = ScopeSettings{Timeout: DefaultRequestTimeout}
	}
	return defaults
}

// WithHandler registers a handler with its identity and scope settings.
func WithHandler(identity HTTPHandlerIdentity, settings map[Scope]ScopeSettings) Option {
	return func(h *Handler) {
		if h.httpHandlers == nil {
			h.httpHandlers = make(map[string]*httpHandler)
		}

		scopes := getDefaultScopeSettings()
		for key, s := range settings {
			if s.Timeout <= 0 {
				s.Timeout = DefaultRequestTimeout
			}
			scopes[key] = s
		}

		newHandler, err := h.createHandler(identity.ConfigName, scopes)
		if err != nil {
			log.Fatalln("[{{.Name}}] unable to create handler:", err)
		}

		h.httpHandlers[identity.ConfigName] = &httpHandler{handler: newHandler, url: identity.URL}
	}
}

// New creates a {{.Name}} HTTP Handler.
func New(svc {{.Name}}.Service, options ...Option) *Handler {
	h := &Handler{service: svc}
	for _, opt := range options {
		opt(h)
	}
	return h
}

func (h *Handler) createHandler(configName string, scopes map[Scope]ScopeSettings) (http.Handler, error) {
	switch configName {
	case ExampleHandler.ConfigName:
		return &FooHandler{service: h.service, scopes: scopes}, nil
	default:
		return nil, errInvalidConfig
	}
}

// GetIdentity returns the handler identity.
func (h *Handler) GetIdentity() string {
	return "{{.Name}}-httphandler"
}

// Start registers all handlers on http.DefaultServeMux.
func (h *Handler) Start() error {
	for _, hh := range h.httpHandlers {
		http.Handle(hh.url, hh.handler)
	}
	return nil
}

var (
	errInvalidConfig = errors.New("invalid handler config")

	// ExampleHandler is the identity of the example {{.Name}} handler.
	ExampleHandler = HTTPHandlerIdentity{
		ConfigName: "example_handler",
		URL:        "/{{.Name}}/example",
	}
)
