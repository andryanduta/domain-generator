package http

import (
	"encoding/json"
	"net/http"
	"strconv"
)

// StandardEnvelope is the standard JSON HTTP response envelope.
type StandardEnvelope struct {
	Header *StandardHeader `json:"header,omitempty"`
	Status *StandardStatus `json:"status,omitempty"`
	Data   interface{}     `json:"data,omitempty"`
	Errors []StandardError `json:"errors,omitempty"`
}

// StandardHeader is the standard JSON response header.
type StandardHeader struct {
	TotalData   int                    `json:"total_data"`
	ProcessTime float64                `json:"process_time"`
	Meta        map[string]interface{} `json:"meta"`
}

// StandardStatus is the standard JSON response status.
type StandardStatus struct {
	ErrorCode int    `json:"error_code"`
	Message   string `json:"message"`
}

// StandardError is the standard JSON HTTP error.
type StandardError struct {
	Code   string      `json:"code"`
	Title  string      `json:"title"`
	Detail string      `json:"detail"`
	Object ErrorObject `json:"object"`
}

// ErrorObject holds additional details of an error.
type ErrorObject struct {
	Text []string `json:"text"`
	Type int64    `json:"type"`
}

func newStandardError(status int, err error) *StandardError {
	return &StandardError{Code: strconv.Itoa(status), Title: err.Error(), Detail: err.Error()}
}

func writeStandardError(w http.ResponseWriter, status int, err error) {
	WriteErrorResponse(w, status, []StandardError{*newStandardError(status, err)})
}

// ResponseDecorator modifies a response before it is written.
type ResponseDecorator interface {
	Decorate(w http.ResponseWriter)
}

// ContentTypeDecorator sets the Content-Type header.
type ContentTypeDecorator string

// Decorate implements ResponseDecorator.
func (d ContentTypeDecorator) Decorate(w http.ResponseWriter) {
	w.Header().Set("Content-Type", string(d))
}

// NewContentTypeDecorator returns a ContentTypeDecorator.
func NewContentTypeDecorator(contentType string) ContentTypeDecorator {
	return ContentTypeDecorator(contentType)
}

// CORSDecorator sets CORS headers.
type CORSDecorator struct {
	allowedOrigin string
}

// Decorate implements ResponseDecorator.
func (d *CORSDecorator) Decorate(w http.ResponseWriter) {
	w.Header().Set("Access-Control-Allow-Credentials", "true")
	w.Header().Set("Access-Control-Allow-Origin", d.allowedOrigin)
}

// WriteResponse applies decorators and writes the response.
func WriteResponse(w http.ResponseWriter, data []byte, status int, decorators ...ResponseDecorator) (int, error) {
	for _, decorator := range decorators {
		decorator.Decorate(w)
	}
	w.WriteHeader(status)
	return w.Write(data)
}

// WriteErrorResponse writes errs as a JSON error envelope.
func WriteErrorResponse(w http.ResponseWriter, code int, errs []StandardError) {
	contentType := NewContentTypeDecorator("application/json")
	body, err := json.Marshal(StandardEnvelope{Errors: errs})
	if err != nil {
		fallbackErr := StandardError{
			Code: strconv.Itoa(http.StatusInternalServerError), Title: "Internal Server Error", Detail: err.Error(),
		}
		fallback, _ := json.Marshal(StandardEnvelope{Errors: []StandardError{fallbackErr}})
		_, _ = WriteResponse(w, fallback, http.StatusInternalServerError, contentType)
		return
	}
	_, _ = WriteResponse(w, body, code, contentType)
}
