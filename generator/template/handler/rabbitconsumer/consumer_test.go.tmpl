package rabbitconsumer

import (
	"context"
	"io"
	"log/slog"
	"slices"
	"testing"
	"time"

	amqp "github.com/rabbitmq/amqp091-go"
)

// fakeAck records how each delivery was settled.
type fakeAck struct{ outcomes []string }

func (a *fakeAck) Ack(uint64, bool) error { a.outcomes = append(a.outcomes, "ack"); return nil }
func (a *fakeAck) Nack(_ uint64, _ bool, requeue bool) error {
	if requeue {
		a.outcomes = append(a.outcomes, "requeue")
	} else {
		a.outcomes = append(a.outcomes, "reject")
	}
	return nil
}
func (a *fakeAck) Reject(_ uint64, requeue bool) error { return a.Nack(0, false, requeue) }

// newTestConsumer returns a Consumer that records backoff waits instead of sleeping.
func newTestConsumer(svc *fakeService) (*Consumer, *[]time.Duration) {
	var waits []time.Duration
	c := New(slog.New(slog.NewTextHandler(io.Discard, nil)), svc)
	c.minBackoff, c.maxBackoff = time.Millisecond, 4*time.Millisecond
	c.sleep = func(_ context.Context, d time.Duration) { waits = append(waits, d) }
	return c, &waits
}

func run(t *testing.T, c *Consumer, ack *fakeAck, ds ...amqp.Delivery) {
	t.Helper()
	deliveries := make(chan amqp.Delivery, len(ds))
	for _, d := range ds {
		d.Acknowledger = ack
		deliveries <- d
	}
	close(deliveries)
	if err := c.Run(context.Background(), deliveries); err == nil {
		t.Fatal("Run should report the closed channel")
	}
}

func TestRunSettlesDeliveries(t *testing.T) {
	tests := []struct {
		name    string
		body    string
		headers amqp.Table
		svcErr  error
		want    string
	}{
		{"success is acked", `{"name":"example"}`, nil, nil, "ack"},
		{"bad payload is rejected", `not json`, nil, nil, "reject"},
		{"retryable error is requeued", `{"name":"example"}`, nil, errUnavailable, "requeue"},
		{"exhausted attempts are rejected", `{"name":"example"}`, amqp.Table{"x-delivery-count": int64(MaxAttempts)}, errUnavailable, "reject"},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			ack := &fakeAck{}
			c, _ := newTestConsumer(&fakeService{err: tt.svcErr})
			run(t, c, ack, amqp.Delivery{Body: []byte(tt.body), Headers: tt.headers})
			if len(ack.outcomes) != 1 || ack.outcomes[0] != tt.want {
				t.Fatalf("outcomes = %v, want [%s]", ack.outcomes, tt.want)
			}
		})
	}
}

// During an outage, requeues must back off exponentially instead of redelivering in a tight loop.
func TestRunBacksOffBeforeRequeue(t *testing.T) {
	ack := &fakeAck{}
	svc := &fakeService{err: errUnavailable}
	c, waits := newTestConsumer(svc)
	msg := amqp.Delivery{Body: []byte(`{"name":"example"}`)}
	run(t, c, ack, msg, msg, msg, msg)

	if want := []time.Duration{1 * time.Millisecond, 2 * time.Millisecond, 4 * time.Millisecond, 4 * time.Millisecond}; !slices.Equal(*waits, want) {
		t.Fatalf("waits = %v, want %v", *waits, want)
	}

	// A success resets the backoff.
	svc.err = nil
	run(t, c, ack, msg)
	svc.err = errUnavailable
	*waits = nil
	run(t, c, ack, msg)
	if want := []time.Duration{time.Millisecond}; !slices.Equal(*waits, want) {
		t.Fatalf("waits after success = %v, want %v", *waits, want)
	}
}
