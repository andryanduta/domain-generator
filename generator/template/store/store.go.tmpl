// NewClientWithTx creates a store client that uses a transaction owned by the caller.
func (s *Store) NewClientWithTx(tx *sqlx.Tx) service.StoreClient {
	return &storeClient{q: tx, isExternalTx: true}
}

// Commit commits the client's transaction. It is a no-op for caller-owned transactions.
func (sc *storeClient) Commit() error {
	tx, ok := sc.q.(*sqlx.Tx)
	if !ok {
		return errors.New("cannot commit on a non-transactional connection")
	}
	if sc.isExternalTx {
		return nil
	}
	return tx.Commit()
}

// Rollback rolls back the client's transaction. It is a no-op for caller-owned transactions.
func (sc *storeClient) Rollback() error {
	tx, ok := sc.q.(*sqlx.Tx)
	if !ok {
		return errors.New("cannot roll back on a non-transactional connection")
	}
	if sc.isExternalTx {
		return nil
	}
	return tx.Rollback()
}

